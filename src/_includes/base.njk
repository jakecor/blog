{#
  Base site layout. Every page/post sets `layout: base.njk` in its
  frontmatter and Eleventy wraps its rendered content in this shell.
  Keeps header/nav/footer in one place instead of repeated per page.

  This block is a Nunjucks comment, not an HTML one, so it stays in the
  source and never reaches the browser. HTML comments here would render
  above the doctype on every single page. (Don't write a closing Nunjucks
  comment marker inside this block -- it ends the comment early and the
  build fails with "unexpected end of comment".)

  Canonical URL and Open Graph/Twitter tags all key off `site.url`
  (src/_data/site.js) rather than the pathPrefix-aware `url` filter, since
  jacobcorcoran.com is the one true canonical location regardless of which
  build target (Cloudflare Pages at root, or the legacy GitHub Pages mirror
  under /blog/) happens to render a page. Internal links DO use `| url`,
  because those must follow the prefix.

  Optional frontmatter:
    description  meta/OG description; falls back to an auto-excerpt of the
                 page content, then to site.description
    image        absolute-from-root path; used for og:image + twitter:image
    ogType       defaults to "website"; post.njk sets "article"
    noindex      true to emit <meta name="robots" content="noindex">
-#}
{%- set metaDescription = description or (content | excerpt) or site.description %}
{%- set ogType = ogType or "website" %}
{%- set canonicalUrl = site.url + page.url -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | {{ site.name }}</title>
  <meta name="description" content="{{ metaDescription }}">
  {% if noindex %}<meta name="robots" content="noindex">
  {% else %}<link rel="canonical" href="{{ canonicalUrl }}">{% endif %}
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
  <link rel="icon" href="{{ '/favicon.svg' | url }}" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ site.url }}/feed.xml">

  <meta property="og:type" content="{{ ogType }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ metaDescription }}">
  <meta property="og:url" content="{{ canonicalUrl }}">
  <meta property="og:site_name" content="{{ site.name }}">
  {% if image %}<meta property="og:image" content="{{ site.url }}{{ image | url }}">{% endif %}

  <meta name="twitter:card" content="{{ 'summary_large_image' if image else 'summary' }}">
  <meta name="twitter:title" content="{{ title }}">
  <meta name="twitter:description" content="{{ metaDescription }}">
  {% if site.twitterHandle %}<meta name="twitter:site" content="{{ site.twitterHandle }}">{% endif %}
  {% if image %}<meta name="twitter:image" content="{{ site.url }}{{ image | url }}">{% endif %}
</head>
<body>
  <header class="site-header">
    <a class="site-title" href="{{ '/' | url }}">Jacob Corcoran</a>
    <nav>
      <a href="{{ '/' | url }}">Posts</a>
      <a href="{{ '/about/' | url }}">About</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <p>&copy; {{ currentYear }} Jacob Corcoran</p>
    <p class="social-links">
      <a href="https://www.linkedin.com/in/jakecorcoran/">LinkedIn</a>
      <a href="https://x.com/jacobcorcoran">X (Twitter)</a>
    </p>
  </footer>
</body>
</html>
