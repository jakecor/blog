---
layout: base.njk
---
<!--
  Post layout: wraps an individual blog post's rendered Markdown with
  its title and date. Chains to base.njk (via the frontmatter above)
  for the shared header/nav/footer. Posts set `layout: post.njk`.
-->
<article>
  <h1>{{ title }}</h1>
  <p class="post-meta">{{ date | readableDate }}</p>
  {{ content | safe }}
</article>
