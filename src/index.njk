---
layout: base.njk
title: Posts
---
<!-- Homepage: lists every post in the "posts" collection, newest first. -->
<ul class="post-list">
  {% for post in collections.posts %}
  <li>
    {% if post.data.image %}
    <img class="post-thumb" src="{{ post.data.image }}" alt="">
    {% endif %}
    <div>
      <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
      <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
      <p class="post-excerpt">{{ post.data.excerpt or (post.templateContent | excerpt) }}</p>
    </div>
  </li>
  {% endfor %}
</ul>
