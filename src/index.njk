---
layout: base.njk
title: Posts
---
<!-- Homepage: short bio, then every post in the "posts" collection, newest first. -->
<p class="bio">Hello, I'm Jake! For nearly two decades I've helped businesses with digital transformation and marketing strategy implementation. I want to help you create great experiences for your customers that help meet your financial goals.</p>

<ul class="post-list">
  {% for post in collections.posts %}
  <li>
    {% if post.data.image %}
    <img class="post-thumb" src="{{ post.data.image | url }}" alt="">
    {% endif %}
    <div>
      <h2><a href="{{ post.url | url }}">{{ post.data.title }}</a></h2>
      <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
      <p class="post-excerpt">{{ post.data.excerpt or (post.templateContent | excerpt) }}</p>
    </div>
  </li>
  {% endfor %}
</ul>
